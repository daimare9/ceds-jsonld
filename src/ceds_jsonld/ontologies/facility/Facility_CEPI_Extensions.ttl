# ──────────────────────────────────────────────────────────
# Facility — CEPI Extensions
# ──────────────────────────────────────────────────────────
# Michigan-specific extensions for Facility entities.
# Adds education institution type, service provider type,
# and facility lease ownership type.
# ──────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# CEPI Extension Named Individuals — BuildingUseType
# ═══════════════════════════════════════════════════════════

cepi:NI001206127869 a ceds:P001206 ;
    rdfs:label "BuildingUseType_AdministrationBuilding"@en .

cepi:NI001206127870 a ceds:P001206 ;
    rdfs:label "BuildingUseType_MaintenanceBuilding"@en .

cepi:NI001206127868 a ceds:P001206 ;
    rdfs:label "BuildingUseType_TransportationFacility"@en .

cepi:NI001206100002 a ceds:P001206 ;
    rdfs:label "BuildingUseType_StorageFacility"@en .

cepi:NI001206127871 a ceds:P001206 ;
    rdfs:label "BuildingUseType_Other"@en .

