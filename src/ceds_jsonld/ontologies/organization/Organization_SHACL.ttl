ceds:hasOrganizationRelationshipTypeShape a sh:PropertyShape ;
    sh:in ( ceds:NI001905172486 ceds:NI001905172487 ceds:NI001905172488 ceds:NI001905172489
            cepi:NI001905172490 cepi:NI001905172491 cepi:NI001905172492
