@prefix ceds: <http://ceds.ed.gov/terms#> .
@prefix cepi: <http://cepi-dev.state.mi.us/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# ── Top-level K12School NodeShape ───────────────────────────────────────────
ceds:K12SchoolShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:HasGradesOfferedShape,
        ceds:hasAdministrativeFundingControlShape,
        ceds:hasCareerClusterShape,
        ceds:hasCharterSchoolManagementOrganizationTypeShape,
        ceds:hasGradeLevelsApprovedShape,
        ceds:hasIncreasedLearningTimeTypeShape,
        ceds:hasK12ProgramOrServiceShape,
        ceds:hasK12SchoolStatusShape,
        ceds:hasSchoolOperationalDetailShape,
        ceds:hasSchoolTypeShape,
        cepi:hasChildNutritionProgramsShape,
        cepi:hasActivelyEducatingStudentsShape,
        ceds:hasOrganizationTitleShape,
        ceds:hasOrganizationIdentificationShape,
        ceds:hasLocationShape,
        ceds:hasOrganizationWebsiteShape,
        ceds:hasOrganizationTypeShape,
        ceds:RecordStartDateTimeShape,
        ceds:RecordEndDateTimeShape,
        cepi:hasLocaleShape ;
    sh:targetClass ceds:C200199 .

# ── K12-specific sub-shapes ────────────────────────────────────────────────
ceds:K12SchoolStatusShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:hasAlternativeSchoolFocusTypeShape,
        ceds:hasNationalSchoolLunchProgramStatusShape,
        ceds:hasVirtualSchoolStatusShape,
        cepi:hasInternationalBaccalaureateProgramShape,
        cepi:hasPercentageOfStudentsInNationalHonorsSocietyShape,
        cepi:hasSchoolOfExcellenceStatusShape,
        cepi:hasStrictDisciplineAcademyShape,
        cepi:hasStudentAccessToRecessShape,
        cepi:hasStudentMentorshipProgramShape,
        cepi:hasUrbanHighSchoolAcademyShape ;
    sh:targetClass ceds:C200203 .

ceds:K12ProgramOrServiceShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:hasTitleIProgramTypeShape,
        cepi:TitleIStatusEffectiveDateShape ;
    sh:targetClass ceds:C200198 .

ceds:SchoolOperationalDetailShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:hasSchoolOperationalStatusShape ;
    sh:targetClass ceds:C200397 .

ceds:CharterSchoolManagementOrganizationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:hasCharterSchoolManagementOrganizationTypeShape,
        ceds:hasCredentialAwardShape,
        ceds:hasK12ProgramOrServiceShape ;
    sh:targetClass ceds:C200379 .

ceds:CredentialAwardShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:CredentialAwardStartDateShape,
        ceds:CredentialAwardEndDateShape ;
    sh:targetClass ceds:C200079 .

cepi:CharterSchoolContractShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:CharterSchoolContractApprovalDateShape,
        ceds:CharterSchoolContractIdNumberShape,
        ceds:CharterSchoolContractRenewalDateShape,
        cepi:hasCharterSchoolContractAmendmentShape ;
    sh:targetClass cepi:C000012 .

cepi:CharterSchoolContractAmendmentShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property cepi:CharterSchoolContractAmendmentDateShape,
        cepi:CharterSchoolContractAmendmentTopicShape ;
    sh:targetClass cepi:C000014 .

# ── Shared shapes referenced from base Organization ────────────────────────
ceds:OrganizationTitleShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:NameOfInstitutionShape,
        ceds:OrganizationNameShape,
        ceds:ShortNameOfOrganizationShape,
        ceds:RecordStartDateTimeShape,
        ceds:RecordEndDateTimeShape ;
    sh:targetClass ceds:C200246 .

ceds:OrganizationIdentificationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:OrganizationIdentifierShape,
        ceds:hasOrganizationIdentificationSystemShape,
        ceds:hasOrganizationIdentifierTypeShape,
        cepi:hasSatTestCenterIndicatorShape ;
    sh:targetClass ceds:C200252 .

ceds:LocationShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:hasLocationAddressShape ;
    sh:targetClass ceds:C200237 .

ceds:LocationAddressShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:AddressStreetNumberAndNameShape,
        ceds:AddressApartmentRoomOrSuiteNumberShape,
        ceds:AddressCityShape,
        ceds:AddressCountyNameShape,
        ceds:AddressPostalCodeShape,
        ceds:LatitudeShape,
        ceds:LongitudeShape,
        ceds:RecordStartDateTimeShape,
        ceds:RecordEndDateTimeShape,
        ceds:hasStateAbbreviationShape,
        ceds:hasCountyANSICodeShape,
        ceds:hasAddressTypeForOrganizationShape,
        cepi:XLocationShape,
        cepi:YLocationShape ;
    sh:targetClass ceds:C200238 .

ceds:OrganizationWebsiteShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdf:id rdf:value rdfs:label ) ;
    sh:property ceds:WebSiteAddressShape ;
    sh:targetClass ceds:C200273 .


